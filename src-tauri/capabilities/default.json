{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:default",
    "opener:default",
    "fs:default",
    "fs:allow-stat",
    "fs:allow-exists",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-copy-file",
    "fs:allow-temp-write",
    "fs:allow-temp-read",
    {
      "identifier": "fs:scope",
      "allow": [
        "$TEMP/**/*",
        "$APPCACHE/**/*",
        "$APPDATA/**/*",
        "$APPLOCALDATA/**/*"
      ]
    }
  ]
}